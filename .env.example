# --- LibreNMS connection ---
LIBRENMS_URL=https://librenms.local.lan
LIBRENMS_TOKEN=your-librenms-api-token
PORT=3001

# --- Overlay networks (optional) ---
# Comma-separated CIDRs used to recognise overlay addresses by IP. Interface-name
# detection (zt*/wg*/tailscale*) always works regardless of these. Set them to your
# own ranges. Tailscale defaults to its standard CGNAT block if left unset.
# ZEROTIER_SUBNETS=10.147.20.0/24
# WIREGUARD_SUBNETS=10.13.13.0/24
# TAILSCALE_SUBNETS=100.64.0.0/10

# --- Docker subnets (optional) ---
# Comma-separated CIDRs for Docker bridge networks. IPs in these ranges are
# excluded from ARP discovery. Defaults to 172.16.0.0/12 (standard Docker pool).
# DOCKER_SUBNETS=172.16.0.0/12

# --- ARP discovery exclusions (optional) ---
# Comma-separated CIDRs to ignore when scanning ARP tables, in addition to the
# overlay and Docker subnets above. Defaults to loopback + link-local.
# ARP_EXCLUDED_SUBNETS=127.0.0.0/8,169.254.0.0/16

# --- Docker host resolution (optional; ignored under network_mode: host) ---
# Only needed when the container can't resolve your LibreNMS hostname on its own.
# LIBRENMS_HOSTNAME=librenms.local.lan
# LIBRENMS_HOST_IP=10.0.0.10
# LOCAL_DNS=10.0.0.1
